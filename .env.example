# Public Stellar testnet configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
TOKEN_ASSET_CODE=USDC
TOKEN_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Fill only after a hash-verified deployment. Never invent or copy an
# unverified contract ID into release evidence.
KERNEL_CONTRACT_ID=
SLA_HOOK_CONTRACT_ID=
SLA_REVIEW_SECS=

# Dedicated, valueless testnet identities. These values begin with S and must
# never be committed, logged, recorded, pasted into chat, or published.
ADMIN_SECRET=
CLIENT_SECRET=
PROVIDER_SECRET=
EVALUATOR_SECRET=
FACILITATOR_SECRET=

# Decimal token units. The demo verifies that testnet USDC reports 7 decimals.
JOB_BUDGET=1

# Normal scenarios need enough time for all state transitions and SLA review.
# The refund scenario intentionally uses a short, ledger-time-based expiry.
JOB_EXPIRY_SECONDS=900
REFUND_EXPIRY_SECONDS=60

# Required facilitator policy. Choose explicitly from a fresh simulation;
# there is deliberately no permissive default.
MAX_FEE_STROOPS=

# Secret-whitelisted demo capture and assembled release manifest are distinct.
# RawEvidenceCapture is input to release tooling; it is not final evidence.
RAW_EVIDENCE_OUTPUT=artifacts/testnet/raw-capture.json
DEPLOYMENT_EVIDENCE_INPUT=artifacts/testnet/deployment-transactions.json
EVIDENCE_OUTPUT=deployments/testnet.json

# Mandatory for releasable evidence. Omit only for an ad hoc run whose raw
# capture will not be assembled or represented as release evidence.
GIT_COMMIT=
KERNEL_WASM_SHA256=
HOOK_WASM_SHA256=
